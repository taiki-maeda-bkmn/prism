{
  "name": "prism",
  "version": "0.1.0",
  "private": true,
  "description": "A local Markdown and PDF workspace with linked notes and transparent windows.",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start-markdown.mjs",
    "install:desktop": "npm run build && node scripts/install-markdown-launcher.mjs",
    "install:markdown": "npm run install:desktop",
    "stage:windows": "node scripts/install-native-windows.mjs",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "build:pdf": "node scripts/build-pdf.mjs",
    "start:pdf": "npm run build:pdf && electron pdf-manager",
    "install:pdf": "npm run build:pdf && node scripts/install-pdf-launcher.mjs",
    "typecheck:pdf": "tsc --noEmit -p pdf-manager/tsconfig.json",
    "test:pdf": "node scripts/test-pdf.mjs",
    "check:pdf": "npm run typecheck:pdf && npm run test:pdf && npm run build:pdf",
    "test:pdf:e2e": "npm run build:pdf && playwright test -c pdf-manager/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@lezer/highlight": "1.2.5",
    "@xmldom/xmldom": "0.9.12",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "lucide-react": "1.57.0",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3"
  }
}
